# Messages written into the parent ITIL object (Ticket / Change / Problem).
msgid "✅ Task «%1$s» validated via checklist «%2$s»."
msgstr "✅ Задача «%1$s» выполнена по чек-листу «%2$s»."

msgid "⏰ Overdue checklist task: «%1$s» (checklist «%2$s») has been pending for more than %3$s."
msgstr "⏰ Просроченная задача чек-листа: «%1$s» (чек-лист «%2$s») ожидает выполнения более %3$s."

msgid "Notifications for overdue checklist tasks"
msgstr "Уведомления о просроченных задачах чек-листов"


msgstr "Настройки обновлены"

# Per-template overrides (PluginChecklistTemplate::showForm).
msgid "Notifications"
msgstr "Уведомления"

msgid "Inherit global setting"
msgstr "Наследовать общую настройку"

# Aggregated bulk validation (PluginChecklistItem::addBatchFollowup) — ONE
# summary followup for the whole selection instead of one message per item.
msgid "✅ %d checklist task validated:"
msgid_plural "✅ %d checklist tasks validated:"
msgstr[0] "✅ Подтверждена %d задача чек-листа:"
msgstr[1] "✅ Подтверждено %d задачи чек-листа:"
msgstr[2] "✅ Подтверждено %d задач чек-листа:"

# Batch endpoint errors (ajax/validate_items.php).
msgid "Access denied"
msgstr "Доступ запрещён"

msgid "Item not found"
msgstr "Задача не найдена"

msgid "Missing item_ids"
msgstr "Не переданы item_ids"

# Blocking switch (PluginChecklistTemplate::showForm) — mirrored onto every
# checklist created from the template; the solve/close veto reads it there.
msgid "Block solving/closing while tasks remain"
msgstr "Блокировать решение/закрытие, пока есть невыполненные задачи"

msgid "Applies to checklists created from this template. Ad-hoc checklists never block."
msgstr "Применяется к чек-листам, созданным по этому шаблону. Произвольные чек-листы никогда не блокируют."

# Search-option labels (rawSearchOptions() on the four plugin itemtypes).
# These are generic column headings shown in the search engine, the column
# picker and CSV/PDF exports.
msgid "Percent done"
msgstr "Прогресс"

msgid "Status"
msgstr "Статус"

msgid "Blocking"
msgstr "Блокирующий"

msgid "Total tasks"
msgstr "Всего задач"

msgid "Completed tasks"
msgstr "Выполнено задач"

msgid "Creation date"
msgstr "Дата создания"

msgid "Due date"
msgstr "Срок выполнения"

msgid "Apply a checklist template"
msgstr "Применить шаблон чек-листа"

msgid "No template selected"
msgstr "Шаблон не выбран"

msgid "Block solving/closing when a blocking checklist has open tasks"
msgstr "Запрещать решение/закрытие, пока в блокирующем чек-листе есть открытые задачи"

msgid "Applies to every ticket, change and problem in this GLPI, not only to those using a checklist template. Disabled by default; the automatic closing CRON is refused too and records a private followup instead."
msgstr "Действует для всех заявок, изменений и проблем в этой GLPI, а не только для использующих шаблон чек-листа. По умолчанию выключено; задание автозакрытия CRON также отклоняется и вместо этого записывает приватное наблюдение."

msgid "This item cannot be solved or closed: %d blocking checklist task is still open."
msgid_plural "This item cannot be solved or closed: %d blocking checklist tasks are still open."
msgstr[0] "Объект нельзя решить или закрыть: осталась %d незакрытая блокирующая задача чек-листа."
msgstr[1] "Объект нельзя решить или закрыть: осталось %d незакрытые блокирующие задачи чек-листа."
msgstr[2] "Объект нельзя решить или закрыть: осталось %d незакрытых блокирующих задач чек-листа."

msgid "Remaining: %s"
msgstr "Осталось: %s"

msgid "Automatic closing was cancelled."
msgstr "Автоматическое закрытие отменено."

msgid "Checklist completed"
msgstr "Чек-лист выполнен"

msgid "Send a GLPI notification when a checklist is completed"
msgstr "Отправлять уведомление GLPI при выполнении чек-листа"

msgid "A second, independent channel: the followup written into the timeline is unaffected. Wording, recipients and per-language text are editable in Setup > Notifications («Checklist completed»). Disabled by default so that upgrading never starts sending mail on its own."
msgstr "Второй, независимый канал: наблюдение, записываемое в ленту, не затрагивается. Текст, получателей и перевод по языкам можно изменить в «Настройки > Уведомления» («Чек-лист выполнен»). По умолчанию выключено, чтобы обновление плагина само по себе не начало рассылать почту."


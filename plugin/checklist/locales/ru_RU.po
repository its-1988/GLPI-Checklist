msgstr "Как в GLPI"

msgid "Public"
msgstr "Публичное"

msgid "Private"
msgstr "Приватное"

msgid "«As in GLPI» follows each technician's own followup privacy preference."
msgstr "«Как в GLPI» — использовать личную настройку приватности наблюдений каждого техника."

msgid "Group bulk validations into a single followup"
msgstr "Объединять массовое подтверждение в одно наблюдение"

